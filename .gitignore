# ---- Dataset: never commit (CC BY-NC 4.0, not ours to redistribute) ----
data/**
!data/
!data/README.md
!data/*/
!data/*/.gitkeep
!data/splits/*.csv
!data/external/
!data/external/gong_unlabelled_manifest.csv

# Kaggle archives / raw downloads anywhere in the repo
*.zip
*.tar
*.tar.gz
*.7z
MAGFiLO*/
**/train_images/
**/test_images/

# Images and masks (in case they end up outside data/)
*.jpg
*.jpeg
*.png
*.fits
*.fits.gz
*.npy
*.npz
*.h5
*.hdf5
*.parquet

# ---- Large artifacts ----
outputs/**
!outputs/.gitkeep
# CODING_SPEC_08: only the two final validated submissions are tracked --
# small text files meant to be in the repo (everything else under outputs/,
# including maps/checkpoints and older local baseline CSVs, stays ignored).
!outputs/submissions/
!outputs/submissions/E030_primary.csv
!outputs/submissions/E013_backup.csv
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.bin
submission*.csv
wandb/
lightning_logs/
mlruns/
runs/

# ---- Credentials ----
kaggle.json
.env
*.env

# ---- Python / tooling ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store
.vscode/
.idea/

# ---- Local planning docs (still read from disk) ----
*.md
!README.md
!**/README.md
!CLAUDE.md
docs/
# CODING_SPEC_08 repo tidy: specs, CLAUDE.md and the decision log are real
# project documentation and belong in the repo; docs/HANDOFF.md (running
# notes, Mac-local) and docs/RESEARCH_PLAN.md stay out -- no negation below
# covers them, so the blanket *.md/docs/ rules above still apply to them.
!docs/
!docs/specs/
!docs/specs/*.md
!docs/Notes.md

# ---- Spec reports and their figures (tracked, unlike other planning docs) ----
!reports/*.md
!reports/figures/**

# ---- weights/ is otherwise gitignored (never commit checkpoints), but this
# audit doc is documentation, not a checkpoint ----
!weights/CHECKPOINT_AUDIT.md

# ---- Paper (Overleaf template, tracked) ----
!reports/paper/**
reports/paper/**/*.aux
reports/paper/**/*.log
reports/paper/**/*.out
reports/paper/**/*.synctex.gz
reports/paper/**/*.fdb_latexmk
reports/paper/**/*.fls
reports/paper/**/*.bbl
reports/paper/**/*.blg
